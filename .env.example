##########################################################
# genai-deploy-onpre 環境設定テンプレート（.env.example）
#
# 使い方:  cp .env.example .env  → このファイルを参考に .env を編集
#
#  ・すべての項目に既定値があり、最低限 §1 の機密値だけ変えれば
#    `docker compose up -d` で起動します。
#  ・機能の ON/OFF は §3 の COMPOSE_PROFILES でまとめて切替（個別 URL 等は微調整用）。
#  ・# で始まる行はコメント。値の後ろに # を書かないこと（値の一部になります）。
##########################################################


# ============================================================
# §1. 機密値  ★ 利用前に必ず変更
# ------------------------------------------------------------
#   .env 直書きより docker secrets 推奨:
#   ./scripts/gen-secrets.sh
#   docker compose -f docker-compose.yml -f docker-compose.secrets.yml up -d
# ============================================================
# 業務DB（PostgreSQL）のパスワード。DATABASE_URL はこの値から自動生成（直接書かない）。
POSTGRES_PASSWORD=changeme
# Keycloak 専用DBのパスワード。
KEYCLOAK_DB_PASSWORD=changeme
# Keycloak 管理者（KEYCLOAK_ADMIN）のパスワード。
KEYCLOAK_ADMIN_PASSWORD=changeme
# SeaweedFS(S3) のシークレットキー。seaweedfs/s3.config.json の secretKey と一致させる。
S3_SECRET_ACCESS_KEY=genai-s3-dev-secret-change-me

# --- 以下も機密。既定値で動くが利用前に変更/設定する（既定のままなら設定不要）---
# Keycloak Admin REST 連携のクライアントシークレット（teams CRUD 等で使用）。
# 既定は dev 値。利用前に実値に変え、Keycloak 側 client secret もローテーションする。
#KEYCLOAK_ADMIN_CLIENT_SECRET=genai-admin-dev-secret-change-me
# ExApp apiKey の暗号鍵（base64(32B) か hex(64)）。設定すると保存 apiKey を AES-256-GCM 暗号化
# （api と worker で同一値必須）。未設定なら平文保存（localhost 単一運用の既定）。
#EXAPP_APIKEY_ENC_KEY=


# ============================================================
# §2. ネットワーク / 公開ポート
# ============================================================
# 全公開ポートの bind アドレス。既定は localhost のみ。
# LAN 公開する場合は実 IP（例 192.168.1.10）に変更（ホスト側ファイアウォール設定も併せて）。
HTTP_BIND=127.0.0.1
# nginx の HTTP / HTTPS ポート。
HTTP_PORT=80
HTTPS_PORT=443
# SeaweedFS(S3) の公開ポート（presigned URL のブラウザ直接 I/O 用）。
# 下の S3_PUBLIC_ENDPOINT の :ポート番号 と必ず一致させる。
S3_PORT=8443
# Keycloak 管理コンソール（localhost のみ公開。LAN 公開時は nginx 経由）。
KEYCLOAK_HTTP_PORT=8088
# 開発用メール受信 UI（Mailpit）。
MAILPIT_UI_PORT=8025
# ログ閲覧 UI（Dozzle）。
DOZZLE_PORT=9980
# api / worker のログレベル（debug / info / warn / error）。
LOG_LEVEL=info


# ============================================================
# §3. 機能トグル（どの機能を起動するか）
# ------------------------------------------------------------
# 指定した profile の機能だけが起動し、web メニューも自動連動する（二重設定不要・web 再ビルド不要）。
#   llm        … チャット/生成/翻訳/作図（最小・既定）
#   embedding  … ＋RAG 文書検索（要 tei）
#   rerank     … ＋RAG リランカ（精度向上・要 tei-reranker）
#   image      … ＋画像生成（要モデル配置）
#   transcribe … ＋文字起こし（要モデル pull）
#   queue      … ＋ExApp 非同期実行 / 文字起こしワーカー
#   sandbox    … ＋Code Interpreter（任意コード実行・§10 のリスク確認必須）
# 例) 標準: llm,embedding   /   フル: llm,embedding,rerank,image,transcribe,queue
COMPOSE_PROFILES=llm
# profile 自動連動を上書きしたい上級者向け（任意・JSON）。指定すると profile 算出より優先。
# 例: ENABLED_USE_CASES={"chat":true,"generate":true,"translate":true,"diagram":true,"image":false,"transcribe":false,"rag":false,"codeInterpreter":false,"apps":false}
#ENABLED_USE_CASES=


# ============================================================
# §4. 業務DB / 認証
# ============================================================
# 業務DB 名・ユーザー（パスワードは §1）。
POSTGRES_DB=genai
POSTGRES_USER=genai
# Keycloak 管理者ユーザー名（パスワードは §1）。
KEYCLOAK_ADMIN=admin
# 外部からの到達ホスト名。LAN 公開時はここを実 IP/FQDN に。
# ★注意: ここを変えると JWT の issuer も変わる。必要なら下の KEYCLOAK_ISSUER も合わせる。
KEYCLOAK_HOSTNAME=https://localhost/auth
# --- 以下は内部固定値（非秘密）。通常変更不要。ホスト名変更時のみ ISSUER を合わせる ---
#KEYCLOAK_ISSUER=https://localhost/auth/realms/genai-realm
#KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/genai-realm/protocol/openid-connect/certs
#KEYCLOAK_AUDIENCE=genai-ai-api
#KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
#KEYCLOAK_ADMIN_REALM=genai-realm
#KEYCLOAK_ADMIN_CLIENT_ID=genai-ai-api-admin


# ============================================================
# §5. チャット LLM
# ============================================================
# LLM 経路の選択（最重要）。ollama(ローカル・既定) / vllm / openai / anthropic / gemini / bedrock
LLM_BACKEND=ollama
# 同梱 ollama の接続先（外部 ollama を使う時だけ変更）。
OLLAMA_BASE_URL=http://ollama:11434/v1
# ollama 経路の既定モデル。
OLLAMA_DEFAULT_CHAT_MODEL=gemma4:e2b
# 推論タイムアウト(ms)。CPU 推論は遅いので長め。
LLM_DEFAULT_TIMEOUT_MS=1800000
# web セレクタ＋api 許可リスト（単一の真実）。変更は nginx と api の再起動で反映（web 再ビルド不要）。
#   軽量(CPU): mistral:7b / llama3.2:3b / gemma4:e2b / gemma4:e4b
#   日本語8B : hf.co/elyza/Llama-3-ELYZA-JP-8B-GGUF
#   中量(GPU): gemma4:26b   大型(GPU): gemma4:31b / mixtral / llama3.3:70b
MODEL_IDS=["gemma4:e2b","gemma4:e4b","mistral:7b","hf.co/elyza/Llama-3-ELYZA-JP-8B-GGUF"]
# リクエスト未指定時の既定モデル（空なら MODEL_IDS[0]）。
LLM_DEFAULT_MODEL=gemma4:e2b
# ollama の context 長(トークン)。既定 4096はダイアグラム生成等の大きいプロンプト(〜7千tok)を
# 切り詰め図が出ない。RAM に余裕(16GB+ 目安)があれば 8192に上げると解消(KV キャッシュ分メモリ増)。
OLLAMA_CONTEXT_LENGTH=4096
# ollama が同時常駐するモデル数の上限。既定 1=低 RAM単一ボックス向け(新モデルのロード時に旧を
# 自動アンロード→セレクタ切替でも二重常駐 OOM しない)。RAM に余裕があれば2 以上に。
OLLAMA_MAX_LOADED_MODELS=1
# 既定サンプリング温度(0〜2)。空＝バックエンド既定(ollama OpenAI 互換は1.0)。温度未指定の全 chat に効く。
# ダイアグラム生成は webが個別に低温(0.2)を送るため、作図目的では本値の設定は不要。
LLM_DEFAULT_TEMPERATURE=

# --- クラウド / 外部 LLM（LLM_BACKEND を切り替えた時だけ設定）---
# いずれも OpenAI 互換。API キーは機密＝ここでは空のまま、実 .env にのみ本物を書く。
# 既定モデルは空なら api 側の保守的既定へ委譲（モデルIDは随時更新のため固定したい時だけ明示）。
# Anthropic（既定 claude-3-5-haiku-latest）
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_CHAT_MODEL=
# Gemini（既定 gemini-1.5-flash）
GEMINI_API_KEY=
GEMINI_DEFAULT_CHAT_MODEL=
# OpenAI（既定 gpt-4o-mini）
OPENAI_API_KEY=
OPENAI_DEFAULT_CHAT_MODEL=
# vLLM（同梱しない＝外部 GPU ホストの OpenAI 互換 URL を指す。空なら api 既定 http://vllm:8000/v1）
VLLM_BASE_URL=
VLLM_DEFAULT_CHAT_MODEL=
# Amazon Bedrock（Converse API + SigV4）。認証は下の AWS_* を読む。
# bedrock 利用時は §11 の AWS_ACCESS_KEY_ID/SECRET を実 AWS 値に（既定 'local' のままだと AccessDenied）。
# region は BEDROCK_REGION 優先、無ければ AWS_REGION。
BEDROCK_REGION=
BEDROCK_DEFAULT_CHAT_MODEL=
# 一時クレデンシャル（STS/IAM ロール由来）を使う時だけ設定。
AWS_SESSION_TOKEN=


# ============================================================
# §6. RAG（文書検索）   profile: embedding
# ------------------------------------------------------------
# すべて既定で動作。RAG の精度/速度を詰めたい時だけ調整。
# ============================================================
# 埋め込み経路（tei=ローカル ruri-v3 / openai）。openai 時は §5 の OPENAI_API_KEY を共用。
EMBEDDING_BACKEND=tei
EMBEDDING_BASE_URL=http://tei:80/v1
# リクエスト時に送るモデル名（表示用に近い。TEI はロード済みモデルを返す）。
EMBEDDING_MODEL_ID=cl-nagoya/ruri-v3-310m
# TEI が実際に読むモデルのパス。既定は int8 量子化版（高速・精度 -10pt 許容）。
# fp32 に戻すなら /models/ruri-v3-310m-onnx を指定。
EMBEDDING_MODEL_PATH=/models/ruri-v3-310m-onnx-int8
# TEI warmup バッチ。低メモリ機で OOM する時は下げる。
EMBEDDING_MAX_BATCH_TOKENS=4096
EMBEDDING_MAX_CLIENT_BATCH_SIZE=8
# 埋め込みタイムアウト(ms)。
EMBEDDING_DEFAULT_TIMEOUT_MS=300000
# --- 検索チューニング ---
# 最終的に LLM へ渡すチャンク数。
RAG_TOP_M=10
# ベクトル検索・全文検索それぞれの取得件数。
RAG_FETCH_K=20
# 2つの検索結果を統合する RRF の定数。
RAG_RRF_K=60
# 文書を分割する1チャンクの最大文字数。
RAG_MAX_CHUNK_SIZE=1000
# 隣接チャンク間で重ねる文字数。
RAG_CHUNK_OVERLAP=120
# pg_bigm 全文検索の類似度しきい値（下げる＝ヒット増/精度減）。
RAG_BIGM_SIMILARITY_LIMIT=0.2


# ============================================================
# §7. RAG リランカ（精度向上）   profile: rerank
# ------------------------------------------------------------
# cross-encoder で検索結果を並べ替え、法令ドメインで Hit@1 45%→90% を実証。
# 有効化: RERANK_ENABLED=true ＋ docker compose --profile rerank up -d tei-reranker（要モデル export）
# ============================================================
RERANK_ENABLED=false
# reranker が読むモデルパス。既定 int8（高速）。fp32 は /models/ruri-v3-reranker-310m-onnx。
RERANKER_MODEL_PATH=/models/ruri-v3-reranker-310m-onnx-int8
# rerank する候補プール数（この中から RAG_TOP_M に絞る）。
RERANK_CANDIDATES=20
# rerank タイムアウト(ms)。
RERANK_DEFAULT_TIMEOUT_MS=60000
# TEI バッチ（reranker 側）。
RERANKER_MAX_BATCH_TOKENS=4096
RERANKER_MAX_CLIENT_BATCH_SIZE=512
# 内部既定（通常変更不要）。
#RERANK_BACKEND=tei
#RERANK_BASE_URL=http://tei-reranker:80


# ============================================================
# §8. 画像生成（stable-diffusion.cpp）   profile: image
# ------------------------------------------------------------
# 利用手順: モデルを ./sdcpp/models/ に配置 → docker compose --profile image up -d sdcpp
# ============================================================
# 経路選択（現状 sdcpp のみ）。
IMAGE_BACKEND=sdcpp
# ./sdcpp/models/ に置いたモデルファイル名（sd-server の -m に渡る）。
SDCPP_MODEL_FILE=v1-5-pruned-emaonly.safetensors
# sd-server の内部エンドポイント（compose の sdcpp:8080 と一致）。
SDCPP_BASE_URL=http://sdcpp:8080
# 生成タイムアウト / ジョブポーリング間隔(ms)。CPU 推論は遅いので長め。
IMAGE_GENERATION_TIMEOUT_MS=300000
IMAGE_POLL_INTERVAL_MS=1000
# 利用可能画像モデルの許可リスト（JSON 配列）。空はリクエスト modelId 素通し。
IMAGE_GENERATION_MODEL_IDS=[]
# リクエスト未指定時の既定モデル（空なら許可リスト[0]）。
IMAGE_DEFAULT_MODEL=


# ============================================================
# §9. 文字起こし（faster-whisper / speaches）   profile: transcribe + queue
# ------------------------------------------------------------
# speaches はモデルを自動DLしない。WHISPER_MODEL を事前 pull すること（README参照）。
# ============================================================
TRANSCRIPTION_BACKEND=faster-whisper
WHISPER_BASE_URL=http://whisper:8000/v1
# 使用モデル（HF リポ名）。既定 large-v3-turbo＝CPU 実用。
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# 言語ヒント（空＝自動検出）。
WHISPER_LANGUAGE=
# 文字起こし HTTP タイムアウト(ms)。長尺見込み。
WHISPER_TIMEOUT_MS=600000
# 非同期ジョブキュー（ElasticMQ 上の別キュー）。
TRANSCRIBE_QUEUE_URL=http://elasticmq:9324/000000000000/genai-transcribe-async


# ============================================================
# §10. Code Interpreter（任意コード実行）   profile: sandbox
# ------------------------------------------------------------
# CSV/Excel を pandas/matplotlib で処理。任意 Python を実行するため多層防御で隔離するが、
# 本環境制約上 seccomp=unconfined + 4 capability の privileged 寄り posture で動く。
# localhost・opt-in・無保証 前提。詳細: docs/sandbox-acceptance-decision.md / sandbox-threat-model.md
#
# 有効化に必要な2つ:
#   1) COMPOSE_PROFILES に sandbox を追加（例: llm,sandbox）
#   2) SANDBOX_ACCEPT_RISK=1 を明示（未設定だと警告して起動中止）
# ============================================================
#SANDBOX_ACCEPT_RISK=1
# api → sandbox の委譲先。
SANDBOX_BASE_URL=http://sandbox:8080
# コード生成 LLM（空なら LLM_DEFAULT_MODEL）。CPU 機は cloud-api、GPU 上位帯は局所モデルが目安。
CODE_INTERPRETER_MODEL=
# 1ジョブの実行タイムアウト(ms) / 生成リトライ回数 / 入力ファイル合計上限(bytes)。
CODE_INTERPRETER_TIMEOUT_MS=60000
CODE_INTERPRETER_MAX_ATTEMPTS=3
CODE_INTERPRETER_MAX_FILE_BYTES=26214400
# sandbox 側の上限: 同時実行 / 壁時計(ms) / 出力(bytes) / 入力ファイル(bytes)。
SANDBOX_MAX_CONCURRENCY=4
SANDBOX_WALL_MS=60000
SANDBOX_MAX_OUTPUT_BYTES=262144
SANDBOX_MAX_FILE_BYTES=8388608


# ============================================================
# §11. ExApp 追加AIアプリ / キュー   profile: queue
# ============================================================
# 非同期キュー（ElasticMQ。認証はダミー可）。AWS SQS 利用時のみ実値を設定。
SQS_ENDPOINT=http://elasticmq:9324
AWS_REGION=ap-northeast-1
EXAPP_QUEUE_URL=http://elasticmq:9324/000000000000/genai-exapp-async
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# SSRF ガード。ローカル ExApp を叩くには allow=true ＋ allowlist にホスト名。
EXAPP_ALLOW_PRIVATE_ENDPOINTS=true
EXAPP_ENDPOINT_ALLOWLIST=echo-exapp
# 外部呼び出しタイムアウト(ms)。
EXAPP_HTTP_TIMEOUT_MS=30000
# これを超える出力は artifacts バケットへ退避(bytes)。
EXAPP_ARTIFACT_THRESHOLD_BYTES=10240


# ============================================================
# §12. オブジェクトストレージ（SeaweedFS / S3）
# ============================================================
# presigned URL のブラウザ到達用（prefix なし・nginx:8443）。LAN 公開時は host を実 IP/FQDN に。
S3_PUBLIC_ENDPOINT=https://localhost:8443
# deleteObject 用の内部直結（通常変更不要）。
S3_INTERNAL_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
# S3 アクセスキー（シークレットは §1）。seaweedfs/s3.config.json の accessKey と一致させる。
S3_ACCESS_KEY_ID=genai-s3-dev-key
# バケット名（file / audio / artifacts）。
FILE_BUCKET_NAME=genai-files
AUDIO_BUCKET_NAME=genai-audio
ARTIFACTS_BUCKET_NAME=genai-artifacts
# api リクエストボディ上限。大きい添付で 413 が出る時に引き上げ。
API_JSON_BODY_LIMIT=10mb


# ============================================================
# §13. 検証・サンプル（通常運用では不要）
# ============================================================
# e2e テストスクリプト用のログイン情報。
E2E_USER=e2e-user
E2E_PASS=changeme
# サンプル echo ExApp（profile example）。検証時に apiKey 突合・完了遅延を設定する場合のみ。
#ECHO_EXAPP_API_KEY=
#ECHO_ASYNC_COMPLETE_AFTER=2
